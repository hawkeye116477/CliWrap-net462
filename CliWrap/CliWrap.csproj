<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>CliWrap-net462</AssemblyName>
    <TargetFramework>net462</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageIcon>favicon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
    <PublicSign>false</PublicSign>
    <Version>3.10.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../favicon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" />
    <PackageReference Include="System.Threading.Tasks.Extensions"/>
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Non-linking dependency on the signaler project to ensure correct build order -->
  <ItemGroup>
    <ProjectReference Include="../CliWrap.Signaler/CliWrap.Signaler.csproj">
      <GlobalPropertiesToRemove>TargetFramework</GlobalPropertiesToRemove>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <CopyLocal>false</CopyLocal>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Embed the signaler executable inside the assembly -->
  <ItemGroup>
    <EmbeddedResource Include="../CliWrap.Signaler/bin/$(Configuration)/net35/CliWrap.Signaler.exe">
      <Link>Signaler.exe</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/..'))=Dev:/CliWrap</PathMap>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>hawkeye116477</Company>
    <PackageProjectUrl>https://github.com/hawkeye116477/CliWrap-net462</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/hawkeye116477/CliWrap-net462/releases</PackageReleaseNotes>
    <Authors>hawkeye116477</Authors>
    <Description>Library for interacting with external command-line interfaces (forked from https://github.com/Tyrrrz/CliWrap)</Description>
  </PropertyGroup>
</Project>